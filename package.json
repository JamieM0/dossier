{
  "name": "dossier",
  "version": "0.1.0",
  "private": true,
  "description": "Dossier MVP monorepo (Tauri + SvelteKit)",
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @dossier/dossier-desktop dev:desktop",
    "dev:ui": "pnpm --filter @dossier/dossier-ui dev",
    "dev:desktop": "pnpm --filter @dossier/dossier-desktop dev:desktop",
    "cli": "node apps/dossier-cli/bin/dossier.js",
    "lab": "pnpm --filter @dossier/cli build:bundle && pnpm --filter @dossier/cli lab",
    "lab:hard": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/hard-run.mjs",
    "lab:real": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/real-run.mjs",
    "build": "pnpm -r build",
    "dist": "pnpm --filter @dossier/dossier-ui build && pnpm --filter @dossier/dossier-desktop dist",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lab:study": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/study-suite.mjs",
    "lab:tmdb": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/tmdb-regression.mjs",
    "lab:confirm": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/confirmation-suite.mjs",
    "lab:override": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/override-suite.mjs",
    "lab:geometry": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/geometry-suite.mjs",
    "lab:refine-signal": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/refine-suite.mjs",
    "lab:refine-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/refine-regressions.mjs",
    "lab:question-policy": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/question-policy-suite.mjs",
    "lab:question-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/question-policy-regressions.mjs",
    "lab:personal-lens": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/personal-lens-suite.mjs",
    "lab:personal-lens-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/personal-lens-regressions.mjs",
    "lab:personal-lens-45": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/personal-lens-45-suite.mjs",
    "lab:personal-lens-45-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/personal-lens-45-regressions.mjs",
    "lab:contexts": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/contexts-suite.mjs",
    "lab:contexts-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/contexts-regressions.mjs",
    "lab:effective-correction": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/effective-correction-suite.mjs",
    "lab:guarded-correction": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/guarded-correction-suite.mjs",
    "lab:impact-correction": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/impact-correction-suite.mjs",
    "lab:learning-stability": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/learning-stability-suite.mjs",
    "lab:learning-stability-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/learning-stability-regressions.mjs",
    "lab:corroboration": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/corroboration-suite.mjs",
    "lab:corroboration-regressions": "pnpm --filter @dossier/cli build:bundle && node apps/dossier-cli/scripts/corroboration-regressions.mjs"
  }
}
